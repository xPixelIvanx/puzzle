# Copia este archivo a .env.local y rellena los valores de tu proyecto de Firebase.
# Las variables NEXT_PUBLIC_* van al navegador: la configuración web de Firebase NO es secreta,
# la seguridad la dan las reglas (database.rules.json / storage.rules).

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://tu-proyecto-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tu-proyecto
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
NEXT_PUBLIC_FIREBASE_APP_ID=

# Dónde guardar las fotos: "rtdb" (por defecto, plan gratuito Spark) o "firebase" (Storage, requiere Blaze + CORS)
NEXT_PUBLIC_IMAGE_STORAGE=rtdb

# Opcional (desarrollo): usar los emuladores locales de Firebase ("1" para activar)
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=

# ---- Solo servidor (Vercel) — NUNCA con prefijo NEXT_PUBLIC_ ----
# Limpieza de salas inactivas (/api/cleanup). Cuenta de servicio en JSON codificado en base64.
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Vercel Cron envía "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=
